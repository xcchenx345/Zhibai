<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/island_card_bg"
    android:padding="16dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/island_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/island_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="等待响应" />

        <TextView
            android:id="@+id/island_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:text="" />

        <ProgressBar
            android:id="@+id/island_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:max="100"
            android:progressTint="#FFFFFFFF"
            android:progressBackgroundTint="#33FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/island_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/island_btn_deny"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/island_btn_deny_bg"
            android:text="拒绝" />

        <TextView
            android:id="@+id/island_btn_approve"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:layout_marginStart="8dp"
            android:textColor="#FF000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/island_btn_approve_bg"
            android:text="允许" />
    </LinearLayout>
</LinearLayout>
